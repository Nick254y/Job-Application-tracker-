# Copy to .env and fill in
CLAUDE_API_KEY=sk-your-anthropic-api-key
DB_URL=sqlite:///job_tracker.db

# Queue type: cron (simple) or celery (advanced)
QUEUE_TYPE=cron

# Alerting
ALI_EMAIL=you@example.com
ALI_WEBHOOK_URL=

# Logging
LOG_LEVEL=INFO

# Client config (will be set per client later)
CLIENT_NAME=Default Client
CRM_PROVIDER=sheets  # sheets / notion / quickbooks / sqlite
